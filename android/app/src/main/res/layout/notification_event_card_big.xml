<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/eventImage"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/eventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Match startet"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center" />

            <TextView
                android:id="@+id/eventName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Event"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:maxLines="2"
                android:ellipsize="end"
                android:alpha="0.95" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/matchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/vsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  vs  "
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:alpha="0.8"
            android:gravity="center" />

        <TextView
            android:id="@+id/player2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/matchMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🕹 Automat 2"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:alpha="0.85"
        android:paddingTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/eventMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="23.02.2026 • 19:00 • Vereinsheim"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:alpha="0.85"
        android:paddingTop="8dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/eventDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ Details stehen hier..."
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:alpha="0.80"
        android:paddingTop="4dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/flyerImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:visibility="visible" />

</LinearLayout>